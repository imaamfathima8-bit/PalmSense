# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.

# Google Gemini API key (free key: https://aistudio.google.com/apikey)
# Leave empty to run the palm reading + chatbot in OFFLINE mode (still works for the demo).
GEMINI_API_KEY=

# Model name. "gemini-flash-latest" always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# PIN needed on the Privacy & Admin page to delete users or clear the log.
ADMIN_PIN=change-me

# Key used to encrypt biometric templates. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is created automatically in data/template.key (git-ignored).
PALMSENSE_TEMPLATE_KEY=
